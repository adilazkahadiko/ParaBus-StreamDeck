{
  "name": "parabus-streamdeck",
  "version": "0.1.3",
  "private": true,
  "description": "Local Stream Deck buttons for the ParaBus external control API v1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build && node scripts/build-tests.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "streamdeck validate io.github.adilazkahadiko.parabus.sdPlugin",
    "pack": "npm run build && streamdeck pack io.github.adilazkahadiko.parabus.sdPlugin --output dist --force",
    "licenses": "node scripts/licenses.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "dependencies": {
    "@elgato/streamdeck": "3.0.4",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.4",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
